check palindrome using recursion
#include <iostream>
using namespace std;

bool checkpali(string str, int i, int j){
    if(i > j){
        return true;
    }

    if(str[i] != str[j]){
        return false;
    }
    else{
        return checkpali(str,i+1,j-1);
    }
}

int main(){
    string name = "abcbas";
    cout << endl;

    bool ispali = checkpali(name,0,name.length()-1);

    if(ispali){
        cout << "Its a palindrome" << endl;
    }
    else{
        cout << "Not a palindrome";
    }

    return 0;

}
