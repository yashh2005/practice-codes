Sorted array check
#include <iostream>
using namespace std;

bool isSor(int arr[], int size){
    if(size == 0 || size == 1){
        return true;
    }
    if(arr[0] > arr[1])
        return false;
    else{
        bool remain = isSor(arr+1, size-1);
        return remain;
    }
}

int main(){
    int arr[5] = {1,2,3,4,5};
    int size=5;

    bool ans= isSor(arr,size);

    if(ans){
        cout << "Sorted" << endl;
    }
    else{
        cout << "Not sorted";
    }
    return 0;
}
