class Solution { // USING SIEVE OF ERATOSTHENES
public:
    int countPrimes(int n) {
        int cnt = 0;
        vector <bool> prime(n+1,true);
        prime[0] = prime[1] = false;
        for(int i = 2;i<n;i++){
            if(prime[i]){
                cnt++;
                for(int j=2*i;j<n;j+=i){
                    prime[j] = 0;
                }
            }
        }
        return cnt;
    }

};

modular exponential
int modularExpo(int x,int n, int m){
    int res =1 ;
    while(n>0){
        if(n&1){
            res = (1LL*(res) + (x)%m); // 1LL typecast
        }
        x=(1LL*(x%m*x%m)%m);
        n=n>>1; // right shift 1 means divide by 2
    }
    return res;
}

Fibonacci using recursion
class Solution {
public:
    int fib(int n) {
        if(n == 0){
            return 0;
        }
        if(n == 1){
            return 1;
        }

        int ans = fib(n-1) + fib(n-2);
        return ans;
    }
};
