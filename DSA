Dynamically created 2D ARRAY for same rows and columns

#include <iostream>
using namespace std;

int main(){
    int n;
    cin >> n;
    int **arr = new int*[n];
    for(int i = 0;i<n;i++){
        arr[i] = new int[n];
    }

    // 2D array created

    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
            cin >> arr[i][j];
        }
    }


    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
            cout << arr[i][j] << " ";
        }
        cout << endl;
    }
    // For releasing memory
    for(int i=0;i<n;i++){
        delete [] arr[i];
    }
    delete []arr;
    return 0;
}
