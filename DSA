Reverse counting using recursion

#include <iostream>
using namespace std;

int count(int n){
    if(n == 0)
        return 1;

    cout << n << endl;

    count(n-1);
}

int main(){
    int n;
    cin >> n;

    int ans = count(n);
    cout << ans << endl;
    return 0;
}
