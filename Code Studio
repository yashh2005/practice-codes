Count Ways to Reach the N-th Stair
int countDistinctWayToClimbStair(long long nStairs){
    if(nStairs < 0){
        return 0;
    }
    if(nStairs == 0){
        return 1;
    }

    int ans = countDistinctWayToClimbStair(nStairs-1) + countDistinctWayToClimbStair(nStairs-2);

    return ans;
}
