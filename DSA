Walking home problem using recursion
#include <iostream> 
using namespace std;

void reachhome(int src, int dest){
    cout << src << endl;
    if(src == dest){
        cout << "Home" << endl;
        return;
    }
    // Processing
    src++;
    // recursive call
    reachhome(src,dest);
}

int main(){
    int dest = 10;
    int src = 1;

    reachhome(src,dest);

    return 0;
}
