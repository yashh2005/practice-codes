Search in a K step array
class Solution {
  public:
    int findStepKeyIndex(vector<int>& arr, int k, int x) {
        // code here
        int i = 0;
        while(i < arr.size()){
            if(arr[i] == x)
                return i;
            int jump = abs(arr[i] - x) / k;
            i += max(1,jump);
        }
        return -1;
    }
};

Check consonents and vowels
class Solution {
  public:
    void checkString(string& s) {
        int v = 0;
        int c = 0;

        // code here
        for(int i=0;i<s.size();i++){
            if(s[i] == 'a' || s[i] == 'e' || s[i] == 'i' || s[i] == 'o' || s[i] == 'u'){
                v++;
            }
            else{
                c++;
            }
        }
        if(v > c)
            cout << "Yes" << endl;
        else if(v < c)
            cout << "No" << endl;
        else if(v == c)
            cout << "Same" << endl;
        else
            cout << "invalid" << endl;
    }
};

prime factorization
void printPrimeFactorization(int n) {
    // code here
    for(int i = 2;i * i <= n;i++){
        while(n % i == 0){
            cout << i << " ";
            n /= i;
        }
    }
    if(n > 1)
        cout << n << " ";
}

