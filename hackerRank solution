Variable size array
#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
using namespace std;


int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */
    int n,q;
    cin >> n >> q;
    vector<vector<int>> arr(n);
    
    for(int i=0;i < n;i++){
        int k;
        cin >> k;
        
        arr[i].resize(k);
        
        for(int j = 0;j < k;j++){
            cin >> arr[i][j];
        }
    }
    while(q--){
        int i,j;
        cin >> i >> j;
        cout << arr[i][j] << endl;
        
    }
    return 0;
}

triplet array comparision funtion solution
vector<int> compareTriplets(vector<int> a, vector<int> b) {
    int alice, bob;
    alice = 0;
    bob = 0;
    
    for(int i=0;i<3;i++){
        if(a[i] > b[i]){
            alice++;
        }
        else if(a[i] < b[i]){
            bob++;
        }
    }
    return {alice,bob};
}

Sum of elements of array
int simpleArraySum(vector<int> ar) {
    int total;
    total = 0;
    for(int i = 0;i<ar.size();i++){
        total += ar[i];
    }
    return total;
}
