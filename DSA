Dynamic Memory Allocation

Create a variable size array
#include <iostream>
using namespace std;

int getsum(int *arr, int n){
    int sum = 0;
    for(int i=0;i<n;i++){
        sum += arr[i];
    }
    return sum;
}

int main(){
    int n;
    cin >> n;

    int* arr = new int[n]; // Creates new array of size n
    
    for(int i=0;i<n;i++){
        cin >> arr[i];
    }
    
    int ans = getsum(arr,n);
    cout << ans;
    return 0;
}
